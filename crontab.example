# Goon Server Kit - example crontab (crontab -e on your host)
# Adjust paths and times to taste. Times are your HOST's local time.

# --- website data (every 5 min) ---
*/5 * * * * python3 /opt/goon-kit/ops/statusgen.py >/dev/null 2>&1
*/5 * * * * python3 /opt/goon-kit/ops/eventsgen.py >/dev/null 2>&1

# --- population sampler (feeds the website chart, every 10 min) ---
*/10 * * * * python3 /opt/goon-kit/ops/sampler.py >/dev/null 2>&1

# --- mod title cache (daily) ---
0 4 * * * python3 /opt/goon-kit/ops/modwatch.py >/dev/null 2>&1

# --- in-game tips + daily restart with countdown ---
15 */2 * * * /opt/goon-kit/ops/goon-ops.sh tip >/dev/null 2>&1
45 5 * * * /opt/goon-kit/ops/goon-ops.sh restart >/dev/null 2>&1

# --- live events (see events-schedule.json; keep cron + json in sync) ---
0 17 * * 1 /opt/goon-kit/ops/goon-events.sh merchant >/dev/null 2>&1
0 21 * * 2 /opt/goon-kit/ops/goon-events.sh fog >/dev/null 2>&1
0 21 * * 3 /opt/goon-kit/ops/goon-events.sh bloodmoon >/dev/null 2>&1
0 20 * * 4 /opt/goon-kit/ops/goon-events.sh megahorde >/dev/null 2>&1
0 18 * * 5 /opt/goon-kit/ops/goon-events.sh doublexp >/dev/null 2>&1
0 20 * * 5 /opt/goon-kit/ops/goon-events.sh wanted >/dev/null 2>&1
0 20 * * 6 /opt/goon-kit/ops/goon-ops.sh saturday >/dev/null 2>&1
0 15 * * 0 /opt/goon-kit/ops/goon-events.sh supplydrop >/dev/null 2>&1
0 19 * * 0 /opt/goon-kit/ops/goon-events.sh siege >/dev/null 2>&1
0 6 * * 1 /opt/goon-kit/ops/goon-events.sh doublexp-end >/dev/null 2>&1
